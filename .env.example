# Copie para .env.local e preencha.
# Opção A — Supabase na nuvem: valores em Project Settings > API Keys.
# Opção B — Supabase local: rode `bunx supabase start` e use os valores que ele imprime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Opcional. Sem chave, a IA usa o modo reserva por regras.
GEMINI_API_KEY=

# Chave que os sensores (simulador/Wokwi) enviam no cabeçalho x-chave-dispositivo.
# Gere uma qualquer, ex.: bunx --bun node -e "console.log(crypto.randomUUID())"
CHAVE_DISPOSITIVO=
